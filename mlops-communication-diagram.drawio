<mxfile host="app.diagrams.net" agent="neuron-agentic-development" version="24.0.0">
  <diagram id="comm-diagram" name="MLOps Communication Diagram">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Diffusers on AWS Neuron — UML Communication Diagram (numbered messages = sequence)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="26" as="geometry" />
        </mxCell>

        <!-- ===== Participants (objects), laid out horizontally ===== -->
        <mxCell id="oDev" value=":MLEngineer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;underline=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oHF" value=":HuggingFaceHub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;underline=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oGPU" value=":GPUTrainer&#10;(CUDA diffusers)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;underline=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oAgent" value=":NeuronAgent&#10;(triage + port)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;underline=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oCompiler" value=":Trainium&#10;(neuronx-cc)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;underline=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="420" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oReg" value=":ArtifactRegistry&#10;(S3 / ECR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;underline=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="700" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="oEndpoint" value=":SageMakerEndpoint&#10;(inf2 / trn)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;underline=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="420" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Links (undirected association lines) + numbered messages ===== -->
        <!-- Dev -> HF : 1 select -->
        <mxCell id="lDevHF" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="oDev" target="oHF"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mDevHF" value="1: selectModel()" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="280" width="120" height="20" as="geometry" />
        </mxCell>

        <!-- Dev -> GPU : 2 fine-tune -->
        <mxCell id="lDevGPU" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="oDev" target="oGPU"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mDevGPU" value="2: fineTune(LoRA)" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="130" height="20" as="geometry" />
        </mxCell>

        <!-- GPU -> Reg : 2.1 push weights -->
        <mxCell id="lGPUReg" style="endArrow=none;html=1;strokeColor=#333333;dashed=1;" edge="1" parent="1" source="oGPU" target="oReg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mGPUReg" value="2.1: putWeights()" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="470" y="715" width="130" height="20" as="geometry" />
        </mxCell>

        <!-- Dev -> Agent : 3 triage -->
        <mxCell id="lDevAgent" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="oDev" target="oAgent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mDevAgent" value="3: triage(model)" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="420" width="120" height="20" as="geometry" />
        </mxCell>

        <!-- Agent self : 3.1 check -->
        <mxCell id="mAgentSelf" value="3.1: checkDynamicShape() / optimumSupported?&#10;3.2 [unsupported] portToNeuronOps()  // static-shape / NKI&#10;     [supported] reuse HF/AWS port  // FLUX/SD/SDXL" style="text;html=1;align=left;fillColor=#fff5e6;strokeColor=#d79b00;spacing=4;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="lAgentSelf" style="endArrow=none;html=1;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="oAgent" target="mAgentSelf"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Agent -> Compiler : 4 compile -->
        <mxCell id="lAgentComp" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="oAgent" target="oCompiler"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mAgentComp" value="4: compile(export=True, tp=8)" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="180" height="20" as="geometry" />
        </mxCell>

        <!-- Compiler self : 4.1 HLO->neff -->
        <mxCell id="mCompSelf" value="4.1: HLO → .neff&#10;4.2 validate(golden)" style="text;html=1;align=left;fillColor=#eaf3e8;strokeColor=#82b366;spacing=4;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="850" y="300" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lCompSelf" style="endArrow=none;html=1;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="oCompiler" target="mCompSelf"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Compiler -> Reg : 5 store neff -->
        <mxCell id="lCompReg" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="oCompiler" target="oReg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mCompReg" value="5: putArtifact(.neff)" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="845" y="585" width="150" height="20" as="geometry" />
        </mxCell>

        <!-- Dev -> Endpoint : 6 deploy -->
        <mxCell id="lDevEnd" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="oDev" target="oEndpoint"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mDevEnd" value="6: deploy(model_data=.neff)" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="700" y="392" width="190" height="20" as="geometry" />
        </mxCell>

        <!-- Endpoint -> Reg : 6.1 load -->
        <mxCell id="lEndReg" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="oEndpoint" target="oReg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="mEndReg" value="6.1: load(.neff)  // no runtime compile" style="text;html=1;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1030" y="585" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- Dev -> Endpoint : 7 infer (return) -->
        <mxCell id="mDevInfer" value="7: infer(image, prompt) → editedImage" style="text;html=1;align=center;fillColor=#e6ffe6;strokeColor=#006600;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="490" width="240" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
