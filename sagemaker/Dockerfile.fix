# Self-contained Neuron serving image — NO AWS DLC base.
# Rationale: every DLC tag mismatched our compile env. The .neff was built with
#   torch-neuronx 2.8.0 / neuronx-cc 2.21.33363 / libneuronxla 2.2.12677 (py310),
# but DLC tags pair those pip versions with an OLDER system runtime (.deb), whose
# libnrt lacks symbols libneuronxla 2.2 needs (undefined symbol: nrt_all_gather).
# Fix: build from a clean Ubuntu, install the SYSTEM Neuron runtime that matches
# libneuronxla 2.2 (Neuron SDK 2.20+ apt repo), then drop in the EXACT venv pip
# stack, then add the SageMaker serving toolkit (what the DLC used to provide).
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# --- base OS + python 3.10 (matches the venv interpreter) -------------------
# nginx: front web server on :8080. NO Java — we use the AWS-documented BYOC
# pattern (Flask + Gunicorn + Nginx) instead of multi-model-server/torchserve
# (which need a JVM Netty frontend). SageMaker only requires a :8080 server
# answering /ping + /invocations; it does NOT require Java.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-venv python3-pip \
        curl gnupg ca-certificates \
        libgomp1 \
        nginx && \
    ln -sf /usr/bin/python3.10 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# --- SYSTEM Neuron runtime from the official apt repo -----------------------
# These .deb provide libnrt with the NRT_2.0.0 symbols (nrt_all_gather etc.)
# that the venv's libneuronxla 2.2.x links against. Installing latest runtime
# (>=2.20 era) satisfies the 2.2 pip ABI.
RUN echo "deb https://apt.repos.neuron.amazonaws.com jammy main" > /etc/apt/sources.list.d/neuron.list && \
    curl -fsSL https://apt.repos.neuron.amazonaws.com/GPG-PUB-KEY-AMAZON-AWS-NEURON.PUB | gpg --dearmor -o /usr/share/keyrings/neuron.gpg && \
    sed -i 's#deb #deb [signed-by=/usr/share/keyrings/neuron.gpg] #' /etc/apt/sources.list.d/neuron.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        aws-neuronx-runtime-lib aws-neuronx-collectives aws-neuronx-tools && \
    rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/aws/neuron/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/aws/neuron/lib:$LD_LIBRARY_PATH

# --- EXACT venv pip stack (torch-neuronx 2.8, neuronx-cc 2.21, optimum 0.4.5) -
# venv-neuron-requirements.txt is a COMPLETE freeze (every transitive dep already
# pinned), so install it with --no-deps: pip must NOT re-resolve (the full set has
# mutually-conflicting pins like sagemaker-core that ResolutionImpossible's). The
# freeze IS the resolved graph; we just materialize it verbatim.
COPY venv-neuron-requirements.txt /tmp/venv-neuron-requirements.txt
RUN python -m pip install --upgrade "pip" "setuptools<81" wheel
RUN python -m pip install --no-deps \
        --extra-index-url https://pip.repos.neuron.amazonaws.com \
        -r /tmp/venv-neuron-requirements.txt
RUN python -m pip install "setuptools<81"

# --no-deps skips pure-python transitive deps that aren't in the freeze. Backfill
# the common ones torch/diffusers/transformers import at load time. These are
# arch-independent (no native build, won't touch torch/numpy), safe to add.
RUN python -m pip install --no-deps \
        typing_extensions filelock fsspec sympy networkx jinja2 mpmath \
        packaging regex tokenizers pyyaml requests tqdm \
        importlib_metadata zipp charset_normalizer idna urllib3 certifi \
        MarkupSafe

# Model libs at EXACT compile-env versions, --no-deps (the freeze's `grep -v @ `
# dropped these conda file:// pins; with-deps would re-resolve and conflict with
# the venv stack). Keep --no-deps to install the code verbatim.
RUN python -m pip install --no-deps \
        "transformers==4.57.6" \
        "diffusers==0.35.2" "optimum-neuron==0.4.5" "optimum==2.0.0" \
        "accelerate==1.8.1" "safetensors" "huggingface-hub" \
        "tokenizers" "regex" "pillow"

# numpy in the venv was conda-installed (file:// freeze pin, stripped by grep),
# so the module copies over but has NO pip .dist-info. transformers queries
# importlib.metadata.version('numpy') at import and dies: PackageNotFoundError.
# Reinstall numpy via pip at the venv version so the metadata exists. --no-deps
# keeps it from dragging anything else.
RUN python -m pip install --no-deps --force-reinstall "numpy==1.26.4"

# Pure-python transitive the model libs import at load time. WITH deps here (not
# --no-deps): these are arch-independent (httpx/httpcore/anyio, pydantic, rich)
# so letting pip pull THEIR transitive can't touch torch/numpy, and it ends the
# one-by-one ModuleNotFound chase (e.g. httpcore needs h11+anyio+certifi).
RUN python -m pip install \
        "httpx" "pydantic" "rich" "psutil" "hf_xet" "requests" "tokenizers"

# --- SageMaker serving stack: Flask + Gunicorn + Nginx (NO JVM) --------------
# The AWS BYOC inference pattern. flask app = serving/predictor.py (wraps the
# four functions in code/inference.py); gunicorn runs it; nginx fronts :8080.
RUN python -m pip install flask gunicorn

# serving/ holds: serve (entrypoint), predictor.py (flask /ping + /invocations),
# wsgi.py (gunicorn target), nginx.conf. Put them on PATH at /opt/program.
COPY serving/ /opt/program/
RUN chmod +x /opt/program/serve
ENV PATH=/opt/program:$PATH
ENV PYTHONUNBUFFERED=TRUE PYTHONDONTWRITEBYTECODE=TRUE
WORKDIR /opt/program

# SageMaker runs the container as `<image> serve`; /opt/program/serve starts
# nginx + gunicorn. (No ENTRYPOINT: SageMaker passes `serve` as the command and
# finds it on PATH, matching the AWS BYOC example.)

# Build-time checks that do NOT init the Neuron runtime (no device in builder).
RUN python -c "import pkg_resources; print('pkg_resources OK')" && \
    python -c "import torch, diffusers, numpy, PIL, flask, gunicorn; print('torch', torch.__version__, '| diffusers', diffusers.__version__, '| flask OK')"
