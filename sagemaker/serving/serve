#!/usr/bin/env python
"""Inference server shell: start nginx + gunicorn, wait until either exits.

SageMaker runs the container as `docker run <image> serve`. With ENTRYPOINT set
to this on PATH, SageMaker's `serve` arg invokes it. nginx (front, :8080) proxies
/ping + /invocations to gunicorn over a unix socket; gunicorn runs wsgi:app
(the Flask predictor). NO JVM.
"""
import os
import signal
import subprocess
import sys

# A FLUX inference is ~10s but gunicorn must also survive the lazy ~50s model
# load on the first request. Keep a generous worker timeout. ONE worker: the
# Neuron pipeline claims the NeuronCores exclusively, so multiple workers would
# fight over the 8 cores. Single worker = one model in HBM.
MODEL_SERVER_TIMEOUT = os.environ.get("MODEL_SERVER_TIMEOUT", "1200")
MODEL_SERVER_WORKERS = os.environ.get("MODEL_SERVER_WORKERS", "1")


def _sigterm(nginx_pid, gunicorn_pid):
    for pid, sig in ((nginx_pid, signal.SIGQUIT), (gunicorn_pid, signal.SIGTERM)):
        try:
            os.kill(pid, sig)
        except OSError:
            pass
    sys.exit(0)


def start_server():
    print(f"Starting inference server: {MODEL_SERVER_WORKERS} worker(s), "
          f"timeout {MODEL_SERVER_TIMEOUT}s", flush=True)

    # pipe nginx logs to the container stdout/stderr (-> CloudWatch)
    subprocess.check_call(["ln", "-sf", "/dev/stdout", "/var/log/nginx/access.log"])
    subprocess.check_call(["ln", "-sf", "/dev/stderr", "/var/log/nginx/error.log"])

    nginx = subprocess.Popen(["nginx", "-c", "/opt/program/nginx.conf"])
    gunicorn = subprocess.Popen([
        "gunicorn",
        "--timeout", str(MODEL_SERVER_TIMEOUT),
        "-k", "sync",
        "-b", "unix:/tmp/gunicorn.sock",
        "-w", str(MODEL_SERVER_WORKERS),
        "wsgi:app",
    ])

    signal.signal(signal.SIGTERM, lambda a, b: _sigterm(nginx.pid, gunicorn.pid))

    pids = {nginx.pid, gunicorn.pid}
    while True:
        pid, _ = os.wait()
        if pid in pids:
            break
    _sigterm(nginx.pid, gunicorn.pid)
    print("Inference server exiting", flush=True)


if __name__ == "__main__":
    start_server()
